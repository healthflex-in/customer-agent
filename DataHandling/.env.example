# Copy to DataHandling/.env. Use non-production credentials and never commit
# the resulting .env file.

# Required persistence and Gemini conversation provider
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=stance-dashboard
MONGO_USERS_COLLECTION=users
MONGO_REPORT_JOBS_COLLECTION=customer-agent-report-jobs
MONGO_CLINICAL_ESCALATIONS_COLLECTION=customer-agent-clinical-escalations
MONGO_TLS_CA_FILE=
GEMINI_API_KEY=

# Required access-link authentication. Generate a distinct random secret of at
# least 32 bytes and store it only in the deployment secret manager.
AUTH_SIGNING_SECRET=
AUTH_ISSUER=stance-access-link-service
AUTH_AUDIENCE=stance-customer-agent
AUTH_MAX_TOKEN_SECONDS=14400
AUTH_CLOCK_SKEW_SECONDS=30

# Optional approved Gemini model overrides
GEMINI_GENERAL_MODEL=gemini-2.5-flash-lite
GEMINI_REASONING_MODEL=gemini-2.5-flash
GEMINI_AUDIO_MODEL=gemini-2.5-flash
GEMINI_SEARCH_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Google Cloud Speech fallback. Compose sets this path; place the ignored JSON
# file at DataHandling/config/google_key.json only when testing the fallback.
GOOGLE_APPLICATION_CREDENTIALS=config/google_key.json

# Optional report upload and Bedrock summary pipeline
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_REGION=us-east-1
S3_BUCKET_NAME=
BEDROCK_MODEL_ID=amazon.nova-2-lite-v1:0
BEDROCK_INFERENCE_PROFILE=

# Resource and concurrency limits
MAX_BLOCKING_CONCURRENCY=8
MAX_AUDIO_SESSION_MB=10
MAX_AUDIO_SESSION_SECONDS=180
MAX_ATTACHMENT_SIZE_MB=15
MAX_ATTACHMENT_FILES=5
MAX_ATTACHMENT_TOTAL_MB=25
MAX_REPORT_PAGES_PER_FILE=5
MAX_REPORT_TOTAL_PAGES=5
MAX_REPORT_IMAGE_PIXELS=25000000
MAX_REPORT_IMAGE_DIMENSION=8000
MAX_BEDROCK_IMAGE_BYTES=3750000
REPORT_JOB_POLL_SECONDS=2
REPORT_JOB_LEASE_SECONDS=900
REPORT_JOB_MAX_ATTEMPTS=3
REPORT_JOB_MAX_BACKLOG=100
REPORT_JOB_RETRY_BASE_SECONDS=30
REPORT_JOB_RETRY_MAX_SECONDS=900

# Privacy-safe operational correlation. Supply a secret random value only in
# the deployment secret manager; do not reuse an API/provider key.
OBSERVABILITY_HASH_KEY=

# Optional external observability; patient content remains off by default.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false

# Optional MCP integration; remote MCP also requires MCP_AUTH_TOKEN.
MCP_URL=
MCP_AUTH_TOKEN=
MCP_ALLOW_PHI=false

# Optional billing-specific overrides. If AI_PRICING_JSON is populated,
# AI_PRICING_VERSION must also be populated. See the optimization audit.
AI_PRICING_VERSION=
AI_PRICING_JSON=
